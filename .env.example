# ============ DeepSeek API 配置 ============
# API 密钥
DEEPSEEK_API_KEY = your_api_key_here
# API 基础地址（默认 DeepSeek 官方地址）
DEEPSEEK_BASE_URL = https://api.deepseek.com


# ============ 模型配置 ============
# 使用的模型名称
DEEPSEEK_MODEL_NAME=DEEPSEEK_MODEL_NAME
# 推理强度（low / medium / high）
DEEPSEEK_REASONING_EFFORT=high
# API 请求超时时间（秒）
DEEPSEEK_API_TIMEOUT=60.0


# ============ 服务配置 ============
# 监听地址（0.0.0.0 允许局域网访问）
SERVER_HOST=0.0.0.0
# 服务端口
SERVER_PORT=8000


# 数据库配置
DATABASE_TYPE = mysql
DATABASE_DRIVER = pymysql
DATABASE_HOST = localhost
DATABASE_PORT = 3306
DATABASE_USER = your_db_user
DATABASE_PASSWORD = your_db_password
DATABASE_NAME = your_db_name

# 数据库连接池的配置
DATABASE_POOL_SIZE = 10
DATABASE_MAX_OVERFLOW = 20
DATABASE_POOL_RECYCLE = 3600


# JWT 配置
SECRET_KEY = your_secret_key_here
JWT_ALGORITHM = HS256
JWT_EXPIRE_DAYS = 7


# ============ Embedding 模型服务（WSL2 内 SGLang，OpenAI 兼容）============
# 启动项目前，必须先在 WSL2 Ubuntu 中启动 bge 模型服务（见 docs/环境与启动说明.md）
EMBEDDING_BASE_URL = http://localhost:30000/v1
# 留空则自动向服务查询模型 id
EMBEDDING_MODEL =
EMBEDDING_DIM = 1024
EMBEDDING_API_KEY = not-needed


# ============ 向量库后端 ============
# memory = numpy 内存向量库（默认，Windows 下稳定）；chroma = 需本机 chromadb 可用
VECTOR_STORE = memory


# RAG 相关配置
# 向量维度
DIMENSION = 1024
# 切割后的文本块大小
CHUNK_SIZE = 500
# 块重叠数量
CHUNK_OVERLAP = 50
# RAG 源文档路径
RAG_DOC_PATH = your_RAG_DOC_PATH